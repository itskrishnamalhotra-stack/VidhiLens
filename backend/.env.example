LEGALAI_AUTH_MODE=dev
# Set a long random value before exposing a development tunnel.
# LEGALAI_DEMO_ACCESS_TOKEN=replace-with-a-random-secret
LEGALAI_DATABASE_PATH=/data/legalai.sqlite
LEGALAI_CATALOGUE_PATH=/artifacts/rag_catalogue_v1.json
LEGALAI_CORS_ORIGINS=http://localhost:5173,https://YOUR_FIREBASE_SITE.web.app
VLLM_BASE_URL=http://127.0.0.1:8000/v1
VLLM_API_KEY=replace-in-production
VLLM_BASE_MODEL_NAME=legalai-base
VLLM_LORA_MODEL_NAME=legal-complaint-lora
LEGALAI_MODEL_CONCURRENCY=4
LEGALAI_QUEUE_TIMEOUT=30
